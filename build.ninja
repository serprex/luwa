rule mkrt
 command=./rt/mkrt.lua
 depfile=$out.d
 deps=gcc
rule mkcomp
 command=./rt/mkcomp.lua
 depfile=$out.d
 deps=gcc
build scripts/comp.wasm:mkcomp | rt/mkcomp.lua
# comp.wasm is listed so it gets built first, the depfile alone doesn't order builds
build rt.wasm:mkrt | rt/mkrt.lua scripts/comp.wasm
default rt.wasm
